# Copy this file to .env and adjust. The .env file is git-ignored.

# Django — generate a new one for production:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Ollama (local LLM used by the admin data assistant)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# GPU layers to offload. 0 = CPU only (GPU inference corrupts tokens on some machines).
OLLAMA_NUM_GPU=0

# Assistant answer cache lifetime in seconds (default: 7200 = 2 hours).
# 0 disables caching. Answers are also invalidated immediately when data changes.
ASSISTANT_CACHE_TTL=7200

# Optional: Redis used for the answer cache when reachable;
# otherwise a per-process in-memory cache is used automatically.
# REDIS_URL=redis://127.0.0.1:6379/1
